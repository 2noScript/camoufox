+#ifndef widget_headless_HeadlessStreamServer_h
+#define widget_headless_HeadlessStreamServer_h
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "mozilla/TimeStamp.h"
+#include "mozilla/gfx/2D.h"
+
+namespace mozilla {
+namespace widget {
+
+class HeadlessCompositorWidget;
+
+enum class RawStreamPixelFormat : uint32_t {
+  BGRA = 1,
+  NV12 = 2,
+};
+
+struct alignas(8) RawStreamFrameHeader {
+  uint32_t magic;
+  uint32_t version;
+  uint32_t width;
+  uint32_t height;
+  uint32_t pixelFormat;
+  uint32_t payloadSize;
+  uint64_t ptsUs;
+};
+static_assert(sizeof(RawStreamFrameHeader) == 32,
+              "RawStreamFrameHeader must be 32 bytes");
+
+enum class RawInputType : uint32_t {
+  MouseMove = 1,
+  MouseDown = 2,
+  MouseUp = 3,
+  Wheel = 4,
+  KeyDown = 5,
+  KeyUp = 6,
+  Text = 7,
+};
+
+struct alignas(4) RawStreamInputPacket {
+  uint32_t magic;      // 0x494D4143 ('C','A','M','I')
+  uint32_t version;    // 1
+  uint32_t type;       // RawInputType
+  uint32_t modifiers;  // bit0=Shift, bit1=Control, bit2=Alt, bit3=Meta
+  int32_t x;           // pixels (Mouse/Wheel), or isRepeat (Key)
+  int32_t y;           // pixels (Mouse/Wheel), or location (Key)
+  int32_t button;      // Mouse button 0..4, or Wheel deltaX
+  int32_t data;        // Wheel deltaY, or DOM keyCode
+  uint32_t textLen;    // Optional UTF-8 payload byte length
+};
+static_assert(sizeof(RawStreamInputPacket) == 36,
+              "RawStreamInputPacket must be 36 bytes");
+
+struct StreamWidgetSlot {
+  std::mutex mutex;
+  HeadlessCompositorWidget* widget = nullptr;
+  int32_t width = 0;
+  int32_t height = 0;
+};
+
+class HeadlessStreamServer final {
+ public:
+  static HeadlessStreamServer* Get();
+
+  bool IsEnabled() const { return mEnabled; }
+  bool HasClient() const { return mHasClient.load(std::memory_order_acquire); }
+  uint32_t TargetFps() const { return mTargetFps; }
+
+  std::shared_ptr<StreamWidgetSlot> RegisterWidget(
+      HeadlessCompositorWidget* aWidget);
+  void UnregisterWidget(const std::shared_ptr<StreamWidgetSlot>& aSlot);
+  void UpdateWidgetSize(const std::shared_ptr<StreamWidgetSlot>& aSlot,
+                        int32_t aWidth, int32_t aHeight);
+
+  // Called on CompositorThread right after SWGL finishes drawing a frame.
+  // Never blocks on socket I/O: overwrites the single latest-frame slot.
+  void SubmitSurface(HeadlessCompositorWidget* aWidget,
+                     gfx::DataSourceSurface* aSurface);
+
+ private:
+  HeadlessStreamServer();
+  ~HeadlessStreamServer() = default;
+
+  struct MainThreadInputState {
+    int16_t buttons = 0;
+    mozilla::TimeStamp lastDownTime[5];
+    int32_t lastDownX[5] = {};
+    int32_t lastDownY[5] = {};
+    uint32_t clickCount[5] = {};
+  };
+
+  void ServerLoop();
+  void InputReaderLoop(int aClientFd,
+                       std::atomic<bool>& aClientDisconnected);
+  void DispatchInputOnMainThread(RawStreamInputPacket aPacket,
+                                 std::string aPayload);
+  void ResetInputStateOnMainThread();
+  void RequestInitialFrames();
+  bool ShouldAcceptFromWidget(HeadlessCompositorWidget* aWidget,
+                              int32_t aWidth, int32_t aHeight);
+
+  bool mEnabled = false;
+  uint32_t mTargetFps = 60;
+  RawStreamPixelFormat mFormat = RawStreamPixelFormat::NV12;
+  std::string mSocketPath;
+
+  std::atomic<bool> mHasClient{false};
+  std::atomic<bool> mStopRequested{false};
+  int mListenFd = -1;
+
+  std::mutex mWidgetsMutex;
+  std::vector<std::shared_ptr<StreamWidgetSlot>> mWidgets;
+  HeadlessCompositorWidget* mActiveWidget = nullptr;
+  std::atomic<uintptr_t> mActiveWidgetKey{0};
+
+  // Accessed exclusively on MainThread inside DispatchInputOnMainThread / Reset.
+  MainThreadInputState mMainInputState;
+
+  std::mutex mFrameMutex;
+  std::condition_variable mFrameCv;
+  RawStreamFrameHeader mStagingHeader{};
+  std::vector<uint8_t> mStagingBuffer;
+  bool mHasPendingFrame = false;
+
+  std::vector<uint8_t> mSendBuffer;
+  std::thread mServerThread;
+};
+
+}  // namespace widget
+}  // namespace mozilla
+
+#endif  // widget_headless_HeadlessStreamServer_h
