+}
+
+/* static */
+void HeadlessWidget::SyncStreamWindowState(HeadlessWidget* aWidget) {
+  if (!aWidget) {
+    return;
+  }
+  HeadlessStreamServer* server = HeadlessStreamServer::Get();
+  if (!server->IsEnabled()) {
+    return;
+  }
+  server->UpdateWindowState(
+      reinterpret_cast<uintptr_t>(aWidget),
+      aWidget->mWindowType == WindowType::Popup,
+      aWidget->mVisible && !aWidget->mDestroyed, aWidget->mBounds.X(),
+      aWidget->mBounds.Y(), aWidget->mBounds.Width(),
+      aWidget->mBounds.Height());
+}
+
+/* static */
+already_AddRefed<HeadlessWidget> HeadlessWidget::FindActiveWindow(
+    uintptr_t aWidgetKey) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (aWidgetKey && sActiveWindows) {
+    for (size_t i = sActiveWindows->Length(); i > 0; --i) {
+      HeadlessWidget* w = sActiveWindows->ElementAt(i - 1);
+      if (reinterpret_cast<uintptr_t>(w) == aWidgetKey && !w->mDestroyed) {
+        RefPtr<HeadlessWidget> ret = w;
+        return ret.forget();
+      }
+    }
+  }
+  return GetActiveWindow();
+}
