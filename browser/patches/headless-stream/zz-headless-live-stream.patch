+class HeadlessStreamServer final {
+ public:
+  static HeadlessStreamServer* Get();
+
+  bool IsEnabled() const { return mEnabled; }
+  bool HasClient() const { return mHasClient.load(std::memory_order_acquire); }
+  uint32_t TargetFps() const { return mTargetFps; }
