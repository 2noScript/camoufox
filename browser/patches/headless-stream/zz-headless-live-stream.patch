+/* static */
+HeadlessStreamServer* HeadlessStreamServer::Get() {
+  static std::once_flag sOnce;
+  static HeadlessStreamServer* sInstance = nullptr;
+  std::call_once(sOnce, []() { sInstance = new HeadlessStreamServer(); });
+  return sInstance;
+}
+
+HeadlessStreamServer::HeadlessStreamServer() {
+#if defined(XP_UNIX)
+  // Only expose the raw frame socket in the parent or GPU process, never in
+  // sandboxed content/utility processes.
+  if (!XRE_IsParentProcess() && !XRE_IsGPUProcess()) {
+    return;
+  }
+
+  const char* sockEnv = std::getenv("CAMOU_HEADLESS_STREAM_SOCKET");
+  if (!sockEnv || !sockEnv[0]) {
+    return;
+  }
+
+  sockaddr_un addr{};
+  if (std::strlen(sockEnv) >= sizeof(addr.sun_path)) {
+    fprintf(stderr,
+            "HeadlessStreamServer: CAMOU_HEADLESS_STREAM_SOCKET path too long\n");
+    return;
+  }
+
+  if (const char* fpsEnv = std::getenv("CAMOU_HEADLESS_STREAM_FPS")) {
+    long parsed = std::strtol(fpsEnv, nullptr, 10);
+    if (parsed >= 1 && parsed <= 120) {
+      mTargetFps = static_cast<uint32_t>(parsed);
+    }
+  }
+
+  if (const char* fmtEnv = std::getenv("CAMOU_HEADLESS_STREAM_FORMAT")) {
+    if (std::strcmp(fmtEnv, "bgra") == 0 || std::strcmp(fmtEnv, "BGRA") == 0) {
+      mFormat = RawStreamPixelFormat::BGRA;
+    }
+  }
+
+  int fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    fprintf(stderr, "HeadlessStreamServer: socket() failed: %d\n", errno);
+    return;
+  }
+
+  mSocketPath = sockEnv;
+  ::unlink(mSocketPath.c_str());
+
+  addr.sun_family = AF_UNIX;
+  std::strncpy(addr.sun_path, mSocketPath.c_str(), sizeof(addr.sun_path) - 1);
+
+  if (::bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+    fprintf(stderr, "HeadlessStreamServer: bind(%s) failed: %d\n",
+            mSocketPath.c_str(), errno);
+    ::close(fd);
+    return;
+  }
+
+  if (::listen(fd, 4) != 0) {
+    fprintf(stderr, "HeadlessStreamServer: listen(%s) failed: %d\n",
+            mSocketPath.c_str(), errno);
+    ::close(fd);
+    ::unlink(mSocketPath.c_str());
+    return;
+  }
+
+  mListenFd = fd;
+  mEnabled = true;
+  mServerThread = std::thread([this]() { ServerLoop(); });
+  mServerThread.detach();
+#endif
+}
+
+std::shared_ptr<StreamWidgetSlot> HeadlessStreamServer::RegisterWidget(
+    HeadlessCompositorWidget* aWidget) {
+  if (!mEnabled) {
+    return nullptr;
+  }
+  auto slot = std::make_shared<StreamWidgetSlot>();
+  slot->widget = aWidget;
+
+  std::lock_guard<std::mutex> lock(mWidgetsMutex);
+  mWidgets.push_back(slot);
+  return slot;
+}
+
+void HeadlessStreamServer::UnregisterWidget(
+    const std::shared_ptr<StreamWidgetSlot>& aSlot) {
+  if (!aSlot) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> slotLock(aSlot->mutex);
+    if (mActiveWidget == aSlot->widget) {
+      std::lock_guard<std::mutex> listLock(mWidgetsMutex);
+      if (mActiveWidget == aSlot->widget) {
+        mActiveWidget = nullptr;
+        mActiveWidgetKey.store(0, std::memory_order_release);
+      }
+    }
+    aSlot->widget = nullptr;
+  }
+
+  std::lock_guard<std::mutex> listLock(mWidgetsMutex);
+  mWidgets.erase(std::remove(mWidgets.begin(), mWidgets.end(), aSlot),
+                 mWidgets.end());
+}
+
+void HeadlessStreamServer::UpdateWidgetSize(
+    const std::shared_ptr<StreamWidgetSlot>& aSlot, int32_t aWidth,
+    int32_t aHeight) {
+  if (!aSlot) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(mWidgetsMutex);
+  aSlot->width = aWidth;
+  aSlot->height = aHeight;
+}
+
+bool HeadlessStreamServer::ShouldAcceptFromWidget(
+    HeadlessCompositorWidget* aWidget, int32_t aWidth, int32_t aHeight) {
+  if (aWidth < 2 || aHeight < 2) {
+    return false;
+  }
+
+  std::lock_guard<std::mutex> lock(mWidgetsMutex);
+  bool hasPrimary = false;
+  for (const auto& slot : mWidgets) {
+    if (slot->width >= kPrimaryMinWidth && slot->height >= kPrimaryMinHeight) {
+      hasPrimary = true;
+      break;
+    }
+  }
+
+  // Skip small popup/tooltip widgets when a normal browser window exists.
+  if (hasPrimary &&
+      (aWidth < kPrimaryMinWidth || aHeight < kPrimaryMinHeight)) {
+    return false;
+  }
+
+  if (!mActiveWidget) {
+    mActiveWidget = aWidget;
+    mActiveWidgetKey.store(aWidget->GetWidgetKey(), std::memory_order_release);
+  } else if (mActiveWidget != aWidget) {
+    bool activeIsTiny = true;
+    for (const auto& slot : mWidgets) {
+      if (slot->widget == mActiveWidget) {
+        activeIsTiny = (slot->width < kPrimaryMinWidth ||
+                        slot->height < kPrimaryMinHeight);
+        break;
+      }
+    }
+    if (activeIsTiny && aWidth >= kPrimaryMinWidth &&
+        aHeight >= kPrimaryMinHeight) {
+      mActiveWidget = aWidget;
+      mActiveWidgetKey.store(aWidget->GetWidgetKey(), std::memory_order_release);
+    }
+  }
+
+  return mActiveWidget == aWidget;
+}
+
+void HeadlessStreamServer::SubmitSurface(HeadlessCompositorWidget* aWidget,
+                                         gfx::DataSourceSurface* aSurface) {
+  if (!mEnabled || !HasClient() || !aSurface) {
+    return;
+  }
+
+  gfx::SurfaceFormat fmt = aSurface->GetFormat();
+  if (fmt != gfx::SurfaceFormat::B8G8R8A8 &&
+      fmt != gfx::SurfaceFormat::B8G8R8X8) {
+    return;
+  }
+
+  gfx::IntSize size = aSurface->GetSize();
+  if (!ShouldAcceptFromWidget(aWidget, size.width, size.height)) {
+    return;
+  }
+
+  gfx::DataSourceSurface::ScopedMap map(aSurface,
+                                        gfx::DataSourceSurface::MapType::READ);
+  if (!map.IsMapped()) {
+    return;
+  }
+
+  RawStreamPixelFormat outFmt = mFormat;
+  uint32_t outW = static_cast<uint32_t>(size.width);
+  uint32_t outH = static_cast<uint32_t>(size.height);
+
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+  outFmt = RawStreamPixelFormat::BGRA;
+#endif
+
+  if (outFmt == RawStreamPixelFormat::NV12) {
+    outW &= ~1u;
+    outH &= ~1u;
+    if (outW < 2 || outH < 2) {
+      return;
+    }
+  }
+
+  size_t payloadSize = 0;
+  if (outFmt == RawStreamPixelFormat::NV12) {
+    payloadSize = static_cast<size_t>(outW) * outH +
+                  static_cast<size_t>(outW) * (outH / 2);
+  } else {
+    payloadSize = static_cast<size_t>(outW) * outH * 4;
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(mFrameMutex);
+    mStagingBuffer.resize(payloadSize);
+
+    if (outFmt == RawStreamPixelFormat::NV12) {
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+      uint8_t* dstY = mStagingBuffer.data();
+      uint8_t* dstUV = dstY + static_cast<size_t>(outW) * outH;
+      int rc = libyuv::ARGBToNV12(
+          map.GetData(), map.GetStride(), dstY, static_cast<int>(outW), dstUV,
+          static_cast<int>(outW), static_cast<int>(outW),
+          static_cast<int>(outH));
+      if (rc != 0) {
+        return;
+      }
+#endif
+    } else {
+      const uint32_t rowBytes = outW * 4;
+      const int32_t srcStride = map.GetStride();
+      const uint8_t* src = map.GetData();
+      uint8_t* dst = mStagingBuffer.data();
+      if (srcStride == static_cast<int32_t>(rowBytes)) {
+        std::memcpy(dst, src, payloadSize);
+      } else {
+        for (uint32_t y = 0; y < outH; ++y) {
+          std::memcpy(dst + static_cast<size_t>(y) * rowBytes,
+                      src + static_cast<size_t>(y) * srcStride, rowBytes);
+        }
+      }
+    }
+
+    mStagingHeader.magic = kStreamMagic;
+    mStagingHeader.version = kStreamVersion;
+    mStagingHeader.width = outW;
+    mStagingHeader.height = outH;
+    mStagingHeader.pixelFormat = static_cast<uint32_t>(outFmt);
+    mStagingHeader.payloadSize = static_cast<uint32_t>(payloadSize);
+    mStagingHeader.ptsUs = NowMicroseconds();
+    mHasPendingFrame = true;
+  }
+  mFrameCv.notify_one();
+}
+
+void HeadlessStreamServer::RequestInitialFrames() {
+  std::vector<std::shared_ptr<StreamWidgetSlot>> slots;
+  {
+    std::lock_guard<std::mutex> lock(mWidgetsMutex);
+    slots = mWidgets;
+  }
+  if (slots.empty()) {
+    return;
+  }
+
+  if (nsCOMPtr<nsIThread> compThread = layers::CompositorThread()) {
+    compThread->Dispatch(NS_NewRunnableFunction(
+        "HeadlessStreamServer::RequestInitialFrames",
+        [slots = std::move(slots)]() {
+          for (const auto& slot : slots) {
+            std::lock_guard<std::mutex> slotLock(slot->mutex);
+            if (slot->widget) {
+              slot->widget->EmitRawFrameIfReady(true);
+            }
+          }
+        }));
+  }
+}
+
+void HeadlessStreamServer::ResetInputStateOnMainThread() {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "HeadlessStreamServer::ResetInputState", [this]() {
+        mMainInputState = MainThreadInputState{};
+      }));
+}
+
+void HeadlessStreamServer::DispatchInputOnMainThread(
+    RawStreamInputPacket aPacket, std::string aPayload) {
+  if (!XRE_IsParentProcess()) {
+    return;
+  }
+  uintptr_t widgetKey = mActiveWidgetKey.load(std::memory_order_acquire);
+  NS_DispatchToMainThread(NS_NewRunnableFunction(
+      "HeadlessStreamServer::DispatchInput",
+      [this, widgetKey, pkt = aPacket, payload = std::move(aPayload)]() {
+        RefPtr<HeadlessWidget> widget =
+            HeadlessWidget::FindActiveWindow(widgetKey);
+        if (!widget || widget->IsDestroyed()) {
+          return;
+        }
+
+        const Modifiers mods = ToGeckoModifiers(pkt.modifiers);
+        const LayoutDeviceIntPoint pt(pkt.x, pkt.y);
+        const RawInputType type = static_cast<RawInputType>(pkt.type);
+
+        switch (type) {
+          case RawInputType::MouseMove: {
+            WidgetMouseEvent event(true, eMouseMove, widget.get(),
+                                   WidgetMouseEvent::eReal);
+            event.mRefPoint = pt;
+            event.mButtons = mMainInputState.buttons;
+            event.mModifiers = mods;
+            event.mTimeStamp = MaskConfig::InputTimeStamp();
+            widget->DispatchInputEvent(&event);
+            break;
+          }
+          case RawInputType::MouseDown: {
+            uint32_t idx = 0;
+            MouseButton btn = ToMouseButton(pkt.button, &idx);
+            mMainInputState.buttons |= MouseButtonsFlagToChange(btn);
+
+            const mozilla::TimeStamp now = mozilla::TimeStamp::Now();
+            bool isMulti = false;
+            if (!mMainInputState.lastDownTime[idx].IsNull()) {
+              double dtMs =
+                  (now - mMainInputState.lastDownTime[idx]).ToMilliseconds();
+              if (dtMs <= 500.0 &&
+                  std::abs(pt.x - mMainInputState.lastDownX[idx]) <= 4 &&
+                  std::abs(pt.y - mMainInputState.lastDownY[idx]) <= 4) {
+                isMulti = true;
+              }
+            }
+            mMainInputState.clickCount[idx] =
+                isMulti ? std::min(mMainInputState.clickCount[idx] + 1u, 3u)
+                        : 1u;
+            mMainInputState.lastDownTime[idx] = now;
+            mMainInputState.lastDownX[idx] = pt.x;
+            mMainInputState.lastDownY[idx] = pt.y;
+
+            WidgetMouseEvent event(true, eMouseDown, widget.get(),
+                                   WidgetMouseEvent::eReal);
+            event.mRefPoint = pt;
+            event.mButton = btn;
+            event.mButtons = mMainInputState.buttons;
+            event.mModifiers = mods;
+            event.mClickCount = mMainInputState.clickCount[idx];
+            event.mTimeStamp = MaskConfig::InputTimeStamp();
+            widget->DispatchInputEvent(&event);
+            break;
+          }
+          case RawInputType::MouseUp: {
+            uint32_t idx = 0;
+            MouseButton btn = ToMouseButton(pkt.button, &idx);
+            mMainInputState.buttons &= ~MouseButtonsFlagToChange(btn);
+
+            WidgetMouseEvent event(true, eMouseUp, widget.get(),
+                                   WidgetMouseEvent::eReal);
+            event.mRefPoint = pt;
+            event.mButton = btn;
+            event.mButtons = mMainInputState.buttons;
+            event.mModifiers = mods;
+            event.mClickCount = std::max(1u, mMainInputState.clickCount[idx]);
+            event.mTimeStamp = MaskConfig::InputTimeStamp();
+            widget->DispatchInputEvent(&event);
+
+            if (btn == MouseButton::eSecondary) {
+              WidgetPointerEvent ctxEvent(true, eContextMenu, widget.get());
+              ctxEvent.mRefPoint = pt;
+              ctxEvent.mButton = MouseButton::eSecondary;
+              ctxEvent.mButtons = mMainInputState.buttons;
+              ctxEvent.mModifiers = mods;
+              ctxEvent.mClickCount = 1;
+              ctxEvent.mTimeStamp = MaskConfig::InputTimeStamp();
+              widget->DispatchInputEvent(&ctxEvent);
+            }
+            break;
+          }
+          case RawInputType::Wheel: {
+            WidgetWheelEvent event(true, eWheel, widget.get());
+            event.mDeltaMode = 0;  // DOM_DELTA_PIXEL
+            event.mDeltaX = static_cast<double>(pkt.button);
+            event.mDeltaY = static_cast<double>(pkt.data);
+            event.mLineOrPageDeltaX =
+                static_cast<int32_t>(std::lround(event.mDeltaX / 33.0));
+            event.mLineOrPageDeltaY =
+                static_cast<int32_t>(std::lround(event.mDeltaY / 33.0));
+            event.mWheelTicksX = event.mDeltaX / 120.0;
+            event.mWheelTicksY = event.mDeltaY / 120.0;
+            event.mIsNoLineOrPageDelta = false;
+            event.mRefPoint = pt;
+            event.mButtons = mMainInputState.buttons;
+            event.mModifiers = mods;
+            event.mTimeStamp = MaskConfig::InputTimeStamp();
+            widget->DispatchInputEvent(&event);
+            break;
+          }
+          case RawInputType::KeyDown:
+          case RawInputType::KeyUp: {
+            const bool isDown = (type == RawInputType::KeyDown);
+            const size_t sep = payload.find('\t');
+            std::string keyUtf8 =
+                sep == std::string::npos ? payload : payload.substr(0, sep);
+            std::string codeUtf8 =
+                sep == std::string::npos ? std::string() : payload.substr(sep + 1);
+
+            NS_ConvertUTF8toUTF16 keyStr(keyUtf8.c_str(), keyUtf8.size());
+            NS_ConvertUTF8toUTF16 codeStr(codeUtf8.c_str(), codeUtf8.size());
+
+            WidgetKeyboardEvent event(true, isDown ? eKeyDown : eKeyUp,
+                                      widget.get());
+            event.mTimeStamp = MaskConfig::InputTimeStamp();
+            event.mModifiers = mods;
+            event.mIsRepeat = isDown && (pkt.x != 0);
+            event.mCodeNameIndex =
+                WidgetKeyboardEvent::GetCodeNameIndex(codeStr);
+            event.mKeyNameIndex = WidgetKeyboardEvent::GetKeyNameIndex(keyStr);
+            if (event.mKeyNameIndex == KEY_NAME_INDEX_USE_STRING) {
+              event.mKeyValue = keyStr;
+            }
+            event.mLocation =
+                pkt.y ? static_cast<uint32_t>(pkt.y)
+                      : WidgetKeyboardEvent::ComputeLocationFromCodeValue(
+                            event.mCodeNameIndex);
+            if (pkt.data > 0) {
+              event.mKeyCode = static_cast<uint32_t>(pkt.data);
+            } else if (event.mKeyNameIndex > KEY_NAME_INDEX_Unidentified &&
+                       event.mKeyNameIndex < KEY_NAME_INDEX_USE_STRING) {
+              event.mKeyCode =
+                  WidgetKeyboardEvent::ComputeKeyCodeFromKeyNameIndex(
+                      event.mKeyNameIndex);
+            } else {
+              event.mKeyCode = FallbackAsciiKeyCode(keyStr);
+            }
+            (void)widget->AttachNativeKeyEvent(event);
+
+            if (RefPtr<TextEventDispatcher> dispatcher =
+                    widget->GetTextEventDispatcher()) {
+              if (NS_SUCCEEDED(
+                      dispatcher->BeginInputTransaction(GetStreamKeyListener()))) {
+                nsEventStatus status = nsEventStatus_eIgnore;
+                if (dispatcher->DispatchKeyboardEvent(
+                        isDown ? eKeyDown : eKeyUp, event, status)) {
+                  if (isDown && status != nsEventStatus_eConsumeNoDefault) {
+                    dispatcher->MaybeDispatchKeypressEvents(event, status);
+                  }
+                }
+              }
+            }
+            break;
+          }
+          case RawInputType::Text: {
+            if (payload.empty()) {
+              break;
+            }
+            NS_ConvertUTF8toUTF16 textStr(payload.c_str(), payload.size());
+            if (RefPtr<TextEventDispatcher> dispatcher =
+                    widget->GetTextEventDispatcher()) {
+              if (NS_SUCCEEDED(
+                      dispatcher->BeginInputTransaction(GetStreamKeyListener()))) {
+                nsEventStatus status = nsEventStatus_eIgnore;
+                dispatcher->CommitComposition(status, &textStr);
+              }
+            }
+            break;
+          }
+        }
+      }));
+}
+
+void HeadlessStreamServer::InputReaderLoop(
+    int aClientFd, std::atomic<bool>& aClientDisconnected) {
+#if defined(XP_UNIX)
+  while (!mStopRequested.load(std::memory_order_acquire) &&
+         !aClientDisconnected.load(std::memory_order_acquire)) {
+    RawStreamInputPacket pkt{};
+    if (!ReadExact(aClientFd, reinterpret_cast<uint8_t*>(&pkt), sizeof(pkt))) {
+      break;
+    }
+    if (pkt.magic != kInputMagic || pkt.version != kStreamVersion ||
+        pkt.textLen > kMaxInputPayloadBytes) {
+      break;
+    }
+    std::string payload;
+    if (pkt.textLen > 0) {
+      payload.resize(pkt.textLen);
+      if (!ReadExact(aClientFd, reinterpret_cast<uint8_t*>(payload.data()),
+                     pkt.textLen)) {
+        break;
+      }
+    }
+    DispatchInputOnMainThread(pkt, std::move(payload));
+  }
+  aClientDisconnected.store(true, std::memory_order_release);
+  mFrameCv.notify_all();
+#endif
+}
+
+void HeadlessStreamServer::ServerLoop() {
+#if defined(XP_UNIX)
+  while (!mStopRequested.load(std::memory_order_acquire)) {
+    struct pollfd pfd{};
+    pfd.fd = mListenFd;
+    pfd.events = POLLIN;
+    int pr = ::poll(&pfd, 1, 250);
+    if (pr <= 0 || !(pfd.revents & POLLIN)) {
+      continue;
+    }
+
+    int clientFd = ::accept(mListenFd, nullptr, nullptr);
+    if (clientFd < 0) {
+      continue;
+    }
+
+#  ifdef SO_NOSIGPIPE
+    int one = 1;
+    ::setsockopt(clientFd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+#  endif
+    struct timeval tv{};
+    tv.tv_sec = 2;
+    tv.tv_usec = 0;
+    ::setsockopt(clientFd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+
+    {
+      std::lock_guard<std::mutex> lock(mFrameMutex);
+      mHasPendingFrame = false;
+    }
+    ResetInputStateOnMainThread();
+    std::atomic<bool> clientDisconnected{false};
+    std::thread inputThread([this, clientFd, &clientDisconnected]() {
+      InputReaderLoop(clientFd, clientDisconnected);
+    });
+
+    mHasClient.store(true, std::memory_order_release);
+    RequestInitialFrames();
+
+    while (!mStopRequested.load(std::memory_order_acquire) &&
+           !clientDisconnected.load(std::memory_order_acquire)) {
+      RawStreamFrameHeader header{};
+      {
+        std::unique_lock<std::mutex> lock(mFrameMutex);
+        mFrameCv.wait_for(lock, std::chrono::milliseconds(200), [&]() {
+          return mHasPendingFrame ||
+                 clientDisconnected.load(std::memory_order_relaxed) ||
+                 mStopRequested.load(std::memory_order_relaxed);
+        });
+        if (mStopRequested.load(std::memory_order_acquire) ||
+            clientDisconnected.load(std::memory_order_acquire)) {
+          break;
+        }
+        if (!mHasPendingFrame) {
+          continue;
+        }
+
+        header = mStagingHeader;
+        mSendBuffer.swap(mStagingBuffer);
+        mHasPendingFrame = false;
+      }
+
+      if (!WriteExact(clientFd, reinterpret_cast<const uint8_t*>(&header),
+                      sizeof(header))) {
+        break;
+      }
+      if (header.payloadSize > 0 &&
+          !WriteExact(clientFd, mSendBuffer.data(), header.payloadSize)) {
+        break;
+      }
+    }
+
+    mHasClient.store(false, std::memory_order_release);
+    clientDisconnected.store(true, std::memory_order_release);
+    ::shutdown(clientFd, SHUT_RDWR);
+    inputThread.join();
+    ::close(clientFd);
+    ResetInputStateOnMainThread();
+
+    {
+      std::lock_guard<std::mutex> lock(mFrameMutex);
+      mHasPendingFrame = false;
+      std::vector<uint8_t>().swap(mStagingBuffer);
+    }
+    std::vector<uint8_t>().swap(mSendBuffer);
+  }
+#endif
+}
