+#if defined(XP_UNIX)
+bool WriteExact(int aFd, const uint8_t* aData, size_t aLen) {
+  size_t sent = 0;
+  while (sent < aLen) {
+    int flags = 0;
+#  ifdef MSG_NOSIGNAL
+    flags |= MSG_NOSIGNAL;
+#  endif
+    ssize_t n = ::send(aFd, aData + sent, aLen - sent, flags);
+    if (n > 0) {
+      sent += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+
+bool ReadExact(int aFd, uint8_t* aData, size_t aLen) {
+  size_t recvd = 0;
+  while (recvd < aLen) {
+    ssize_t n = ::recv(aFd, aData + recvd, aLen - recvd, 0);
+    if (n > 0) {
+      recvd += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+#endif
+
+uint64_t NowMicroseconds() {
+  auto now = std::chrono::steady_clock::now().time_since_epoch();
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::microseconds>(now).count());
+}
+
+Modifiers ToGeckoModifiers(uint32_t aMods) {
+  Modifiers mods = MODIFIER_NONE;
+  if (aMods & (1u << 0)) mods |= MODIFIER_SHIFT;
+  if (aMods & (1u << 1)) mods |= MODIFIER_CONTROL;
+  if (aMods & (1u << 2)) mods |= MODIFIER_ALT;
+  if (aMods & (1u << 3)) mods |= MODIFIER_META;
+  return mods;
+}
+
+MouseButton ToMouseButton(int32_t aButton, uint32_t* aOutIndex) {
+  switch (aButton) {
+    case 0:
+      *aOutIndex = 0;
+      return MouseButton::ePrimary;
+    case 1:
+      *aOutIndex = 1;
+      return MouseButton::eMiddle;
+    case 2:
+      *aOutIndex = 2;
+      return MouseButton::eSecondary;
+    case 3:
+      *aOutIndex = 3;
+      return MouseButton::eX1;
+    case 4:
+      *aOutIndex = 4;
+      return MouseButton::eX2;
+    default:
+      *aOutIndex = 0;
+      return MouseButton::ePrimary;
+  }
+}
+
+uint32_t FallbackAsciiKeyCode(const nsAString& aKey) {
+  if (aKey.Length() != 1) {
+    return 0;
+  }
+  char16_t ch = aKey.CharAt(0);
+  if (ch >= u'a' && ch <= u'z') {
+    return static_cast<uint32_t>(ch - u'a' + NS_VK_A);
+  }
+  if (ch >= u'A' && ch <= u'Z') {
+    return static_cast<uint32_t>(ch - u'A' + NS_VK_A);
+  }
+  if (ch >= u'0' && ch <= u'9') {
+    return static_cast<uint32_t>(ch - u'0' + NS_VK_0);
+  }
+  if (ch == u' ') {
+    return NS_VK_SPACE;
+  }
+  return 0;
+}
