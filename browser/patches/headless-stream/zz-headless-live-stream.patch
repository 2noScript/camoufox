+#ifndef widget_headless_HeadlessStreamServer_h
+#define widget_headless_HeadlessStreamServer_h
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
