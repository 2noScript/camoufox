+#if defined(XP_UNIX)
+bool WriteExact(int aFd, const uint8_t* aData, size_t aLen) {
+  size_t sent = 0;
+  while (sent < aLen) {
+    int flags = 0;
+#  ifdef MSG_NOSIGNAL
+    flags |= MSG_NOSIGNAL;
+#  endif
+    ssize_t n = ::send(aFd, aData + sent, aLen - sent, flags);
+    if (n > 0) {
+      sent += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+
+bool ReadExact(int aFd, uint8_t* aData, size_t aLen) {
+  size_t recvd = 0;
+  while (recvd < aLen) {
+    ssize_t n = ::recv(aFd, aData + recvd, aLen - recvd, 0);
+    if (n > 0) {
+      recvd += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+#endif
