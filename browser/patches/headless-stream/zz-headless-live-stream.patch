+void BlendPremulBgra(uint8_t* aDst, int32_t aDstW, int32_t aDstH,
+                     const uint8_t* aSrc, int32_t aSrcW, int32_t aSrcH,
+                     int32_t aOffsetX, int32_t aOffsetY) {
+  const int32_t xStart = std::max<int32_t>(0, aOffsetX);
+  const int32_t yStart = std::max<int32_t>(0, aOffsetY);
+  const int32_t xEnd = std::min<int32_t>(aDstW, aOffsetX + aSrcW);
+  const int32_t yEnd = std::min<int32_t>(aDstH, aOffsetY + aSrcH);
+  if (xStart >= xEnd || yStart >= yEnd) {
+    return;
+  }
+
+  for (int32_t dy = yStart; dy < yEnd; ++dy) {
+    const int32_t sy = dy - aOffsetY;
+    uint8_t* dstRow =
+        aDst + static_cast<size_t>(dy) * aDstW * 4 + static_cast<size_t>(xStart) * 4;
+    const uint8_t* srcRow = aSrc + static_cast<size_t>(sy) * aSrcW * 4 +
+                            static_cast<size_t>(xStart - aOffsetX) * 4;
+    const int32_t count = xEnd - xStart;
+    for (int32_t i = 0; i < count; ++i) {
+      const uint8_t a = srcRow[3];
+      if (a == 255) {
+        dstRow[0] = srcRow[0];
+        dstRow[1] = srcRow[1];
+        dstRow[2] = srcRow[2];
+        dstRow[3] = 255;
+      } else if (a != 0) {
+        const uint32_t invA = 255u - a;
+        dstRow[0] = static_cast<uint8_t>(
+            std::min<uint32_t>(255u, srcRow[0] + (dstRow[0] * invA + 127u) / 255u));
+        dstRow[1] = static_cast<uint8_t>(
+            std::min<uint32_t>(255u, srcRow[1] + (dstRow[1] * invA + 127u) / 255u));
+        dstRow[2] = static_cast<uint8_t>(
+            std::min<uint32_t>(255u, srcRow[2] + (dstRow[2] * invA + 127u) / 255u));
+        dstRow[3] = 255;
+      }
+      dstRow += 4;
+      srcRow += 4;
+    }
+  }
+}
