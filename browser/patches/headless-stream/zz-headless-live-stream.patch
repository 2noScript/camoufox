+void HeadlessCompositorWidget::EmitRawFrameIfReady(bool aForce) {
+  HeadlessStreamServer* server = HeadlessStreamServer::Get();
+  if (!server->IsEnabled() || !server->HasClient() || !mDrawTarget) {
+    return;
+  }
+
+  const double intervalUs = 1000000.0 / static_cast<double>(server->TargetFps());
+  const mozilla::TimeDuration minInterval =
+      mozilla::TimeDuration::FromMicroseconds(intervalUs);
+  const mozilla::TimeStamp now = mozilla::TimeStamp::Now();
+
+  if (!aForce && !mLastRawCaptureTime.IsNull()) {
+    mozilla::TimeDuration elapsed = now - mLastRawCaptureTime;
+    if (elapsed < minInterval) {
+      if (!mRawTrailingScheduled) {
+        mRawTrailingScheduled = true;
+        uint32_t delayMs = static_cast<uint32_t>(
+            std::max(1.0, (minInterval - elapsed).ToMilliseconds()));
+        NS_DelayedDispatchToCurrentThread(
+            NewRunnableMethod(
+                "HeadlessCompositorWidget::TrailingRawSnapshot", this,
+                &HeadlessCompositorWidget::TrailingRawSnapshot),
+            delayMs);
+      }
+      return;
+    }
+  }
+
+  RefPtr<gfx::SourceSurface> snapshot = mDrawTarget->Snapshot();
+  if (!snapshot) {
+    return;
+  }
+  RefPtr<gfx::DataSourceSurface> dataSurface = snapshot->GetDataSurface();
+  if (!dataSurface) {
+    return;
+  }
+
+  mLastRawCaptureTime = now;
+  server->SubmitSurface(this, dataSurface.get());
+}
